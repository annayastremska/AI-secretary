# model weights and caches never live inside the repo
models/
*.gguf
.cache/

# python
__pycache__/
*.pyc
.venv/
venv/

# jupyter
.ipynb_checkpoints/

# os
.DS_Store
Thumbs.db

# --- локальний стан пайплайна, не частина коду ---

# Папка-приймач: робочі файли конкретної машини. Сам каталог лишається
# (через .gitkeep), щоб `python run_pipeline.py` працював на свіжому клоні.
data/inbox/*
!data/inbox/.gitkeep
# Один демонстраційний документ лежить у черзі в самому репозиторії, щоб
# після клону `python run_pipeline.py` було чим запустити одразу.
# УВАГА: перший прогін у режимі сканування ПЕРЕНЕСЕ його в data/processed/,
# і git покаже його як видалений -- повернути: git restore data/inbox
!data/inbox/посвідчення_відрядження_заповнений.docx

# Результат прогонів (документи + індекс хешів) -- генерується заново.
data/output/

# Архів оброблених вхідних файлів -- локальний стан конкретної машини.
data/processed/
data/failed/

# Локальний конфіг: тут з'являться DSN Postgres і ключі MinIO, тому в репо
# лежить лише config.example.yaml. Скопіюйте його в config.yaml.
config.yaml
