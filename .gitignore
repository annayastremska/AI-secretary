# secrets & local env — never in the repo
.env
.env.*
*.pem
*.key

# junk
.DS_Store
__pycache__/
*.pyc
node_modules/
.venv/
venv/
dist/
build/

# NOTE: agent-sessions/**/*.jsonl is intentionally NOT ignored — exported session
# logs are part of the course contract. Scrub secrets before committing them.

# ─────────────────────────────────────────────────────────────
# ГОЛОВНЕ: реальні документи замовника в git не потрапляють.
# Це правило проєкту, не зручність. Не послаблювати без Дениса.

# Реальні документи — тільки локально, ніколи в git
data-private/
data-real/
*.real
*.real.*

# Скани й фото документів. Синтетичні зразки — виняток нижче
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.heic
*.docx
*.doc
*.xlsx
*.xls

# Виняток: синтетика і схеми, які свідомо тримаємо в репо.
# ЄДИНЕ місце для файлів документів -- data/eval/ (зразки + еталон). Реальні
# документи не пускає ні цей виняток, ні що інше: вони живуть у data-private/
# і в data/inbox/, обидві заблоковані вище й нижче.
!data/eval/**
!docs/**/*.png
!docs/**/*.svg

# Виняток другий: порожні бланки генератора. Це публічні форми (Додаток 28 і
# Додаток 30 до Інструкції з діловодства у ЗСУ) без жодного заповненого поля --
# з них генератор робить синтетичні документи. Реальних документів тут не буває.
!data/generator/templates/*.docx

# Дампи бази — можуть містити витягнуті реальні дані.
# Схема (DDL) у git потрібна, тому *.sql цілком не блокуємо
dumps/
*.dump
backup*.sql
*_dump.sql
*.sqlite
*.sqlite3
*.db

# Секрети
!.env.example
credentials.json
service-account*.json

# Python
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Моделі й ваги — важке, в git не тягнемо
*.gguf
*.safetensors
*.bin
models/

# Службове
.idea/
.vscode/
*.log

# ─────────────────────────────────────────────────────────────
# pipeline (Аня): локальний стан прогонів, не частина коду

# Папка-приймач: робочі файли конкретної машини. Сам каталог лишається
# (через .gitkeep), щоб `python run_pipeline.py` працював на свіжому клоні.
data/inbox/*
!data/inbox/.gitkeep

# Результат прогонів (документи + індекс хешів) -- генерується заново.
data/output/

# Архів оброблених вхідних файлів -- локальний стан конкретної машини.
data/processed/
data/failed/

# Локальний конфіг: налаштування конкретної машини (шляхи, наявність
# моделі). У репо лежить лише config.example.yaml -- скопіюйте його.
config.yaml

# Звіти оцінювача -- генеровані виходи прогонів. Самі цифри й що вони
# означають фіксуються в документації; JSON лишається на диску для діфу
# між прогонами, але в історію коду не йде. Правило стоїть ПІСЛЯ !data/eval/**
# -- останній збіг перемагає, тому виняток вище звіти не повертає.
data/eval/reports/

# Worktree-и агентів: копії репозиторію всередині репозиторію (21 МБ),
# створюються харнесом на час роботи агента.
.claude/

# Кеш ваг і моделей поруч із кодом.
.cache/

# Архіви цілим класом: саме архівом найпростіше занести пачку реальних
# сканів одним `git add`, обійшовши перелік розширень вище.
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Файли-замки Word: відкритий .docx створює поруч ~$-копію.
~$*
