# secrets & local env — never in the repo
.env
.env.*
*.pem
*.key

# junk
.DS_Store
__pycache__/
*.pyc
node_modules/
.venv/
venv/
dist/
build/

# NOTE: agent-sessions/**/*.jsonl is intentionally NOT ignored — exported session
# logs are part of the course contract. Scrub secrets before committing them.

# ─────────────────────────────────────────────────────────────
# ГОЛОВНЕ: реальні документи замовника в git не потрапляють.
# Це правило проєкту, не зручність. Не послаблювати без Дениса.

# Реальні документи — тільки локально, ніколи в git
data-private/
data-real/
*.real
*.real.*

# Скани й фото документів. Синтетичні зразки — виняток нижче
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.heic
*.docx
*.doc
*.xlsx
*.xls

# Виняток: синтетика і схеми, які свідомо тримаємо в репо
!eval/synthetic/**
!docs/**/*.png
!docs/**/*.svg

# Дампи бази — можуть містити витягнуті реальні дані.
# Схема (DDL) у git потрібна, тому *.sql цілком не блокуємо
dumps/
*.dump
backup*.sql
*_dump.sql
*.sqlite
*.sqlite3
*.db

# Секрети
!.env.example
credentials.json
service-account*.json

# Python
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Моделі й ваги — важке, в git не тягнемо
*.gguf
*.safetensors
*.bin
models/

# Службове
.idea/
.vscode/
*.log
