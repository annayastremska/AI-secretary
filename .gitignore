# model weights and caches never live inside the repo
models/
*.gguf
.cache/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# jupyter
.ipynb_checkpoints/

# os / редактори
.DS_Store
Thumbs.db
.vscode/
.idea/

# Файли-замки Word: відкритий .docx у context/ створює поруч ~$-копію.
~$*

# --- локальний стан пайплайна, не частина коду ---

# Папка-приймач: робочі файли конкретної машини. Сам каталог лишається
# (через .gitkeep), щоб `python run_pipeline.py` працював на свіжому клоні.
data/inbox/*
!data/inbox/.gitkeep

# Результат прогонів (документи + індекс хешів) -- генерується заново.
data/output/

# Архів оброблених вхідних файлів -- локальний стан конкретної машини.
data/processed/
data/failed/

# Локальний конфіг: налаштування конкретної машини (шляхи, наявність
# моделі). У репо лежить лише config.example.yaml -- скопіюйте його.
config.yaml

# Worktree-и агентів: копії репозиторію всередині репозиторію (21 МБ),
# створюються харнесом на час роботи агента.
.claude/

# Звіти оцінювача -- генеровані виходи прогонів. Самі цифри й що вони
# означають фіксуються в context/*.md; JSON лишається на диску для діфу
# між прогонами, але в історію коду не йде.
data/eval/reports/

# Логи прогонів у корені (коли команду запускають не з --report-у).
*.log

# --- запобіжник проти реальних документів і секретів ---
#
# Найдорожче обмеження проєкту (context/security-constraints.md): реальні
# документи частини не можна тримати в репозиторії навіть у замазаному
# вигляді. Правило в README тримається на увазі людини; ці рядки діють і
# тоді, коли на нього не дивляться. Архіви тут навмисно ЦІЛИМ класом --
# саме архівом найпростіше занести пачку реальних сканів одним `git add`.
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Дампи бази: `schema_dump.sql` та подібне надсилає команда БД. Їхній код --
# у їхній частині репо, а дамп із даними -- ніде.
*.sql
*.dump

# Секрети: ключі моделей і доступи. Своїх немає й не має з'явитись.
.env
.env.*
*.pem
*.key
