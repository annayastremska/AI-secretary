# Копіюйте в .env і заповніть реальними значеннями (той файл у .gitignore,
# сюди секрети не потрапляють). Потрібно для docker-compose.yml (db/).

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me
POSTGRES_PORT=5433

APP_DB_NAME=milidoc
APP_DB_USER=milidoc_app
APP_DB_PASSWORD=change_me_app

READONLY_DB_USER=milidoc_readonly
READONLY_DB_PASSWORD=change_me_ro

# Для alembic-міграцій (app/db/env.py читає саме цю змінну)
DATABASE_URL=postgresql+psycopg://milidoc_app:change_me_app@localhost:5433/milidoc

# Тека оригіналів документів (MinIO прибрано 20.08.2026 -- див. docker-compose).
# Порожньо = data/originals у корені проєкту.
ORIGINALS_DIR=

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_app
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8081
# Згенерувати: python -c "import secrets; print(secrets.token_hex(24))"
AIRFLOW_WEBSERVER_SECRET_KEY=change_me
# Згенерувати: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
