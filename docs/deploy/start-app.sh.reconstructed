#!/usr/bin/env bash
# ВІДНОВЛЕНО З ПАМ'ЯТІ ПРО ВИВІД, А НЕ СКОПІЮВАНО.
#
# 01.09.2026. Оригінал жив лише на сервері (`~/anya/ai-secretary/start-app.sh`)
# і в git не поїхав. Віртуалку вимкнули посеред моєї звірки: за п'ять хвилин до
# того машина відповідала (uptime 9 днів 20 годин), потім ping почав давати
# «Destination host unreachable» від шлюзу провайдера 185.9.40.14 -- тобто
# вузол вимкнений, а не порт закритий.
#
# Це відновлення з ПРОЧИТАНИХ 12 рядків (я друкувала `head -12` цього файла під
# час звірки). Тому файл названий `.reconstructed`:
#
#   - рядки нижче -- ті, що я справді бачила, дослівно;
#   - чи були в оригіналі рядки ПІСЛЯ них -- я не знаю: `head -12` показав
#     ровно стільку, і `exec` в кінці означає, що продовження радше не було;
#   - жодного секрету тут немає: пароль і ключі лежали в `.env`, який на
#     сервері й лишився.
#
# Нащо зберігати. Це єдиний запис того, ЯК сервіс запускався: який профіль
# пайплайна, де ваги моделі, скільки шарів на GPU і чому порт 80.
set -euo pipefail
cd "$(dirname "$0")"
set -a; . ./.env; set +a
export APP_PIPELINE_CONFIG=demos/upload_app/config-gpu.yaml
export CHAT_MODEL_PATH=/home/ubuntu/shared/models/mamaylm-27b-q4_k_m.gguf
export CHAT_N_GPU_LAYERS=-1          # 27B цілком у VRAM: виклик 0.21 с
mkdir -p logs
exec sudo -E .venv/bin/python -m uvicorn demos.upload_app.app:app \
     --host 0.0.0.0 --port 80
